{
  "name": "oc-web-rotate",
  "version": "0.0.1",
  "description": "Rotate OpenCode2 web search and fetch providers",
  "keywords": [
    "opencode",
    "opencode2",
    "opencode-plugin",
    "opencode2-plugin",
    "webfetch",
    "websearch"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/oc-web-rotate.git"
  },
  "packageManager": "bun@1.4.4",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/xai": "^5.0.40",
    "@extractus/article-extractor": "^9.0.1",
    "@firecrawl/html-extractor": "^0.1.2",
    "@hyperbrowser/sdk": "^1.4.1",
    "@jocmp/mercury-parser": "^3.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@opencode/plugin": "^2.2.6",
    "@truto/turndown-plugin-gfm": "^1.0.7",
    "ai": "^7.0.165",
    "defuddle": "~0.19.6",
    "duck-duck-scrape": "^2.2.7",
    "es-toolkit": "^1.53.2",
    "eventsource-parser": "^4.1.3",
    "exa-js": "^2.28.0",
    "fast-xml-parser": "^5.12.0",
    "file-type": "^22.3.0",
    "google-sr": "^6.0.0",
    "html-to-text": "^10.0.1",
    "keenable": "~0.1.4",
    "linkedom": "~0.18.15",
    "lru-cache": "^11.5.3",
    "marked": "^18.1.3",
    "p-map": "^7.1.1",
    "scrapfly-sdk": "~0.12.0",
    "trafilatura": "^0.2.0",
    "turndown": "^7.2.5",
    "web-rotate-core": "0.2.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
