{
  "name": "opencode-web-rotate",
  "version": "0.1.0",
  "description": "OpenCode 2 web search and fetch provider rotation",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.1",
    "effect": "4.0.1",
    "web-rotate-core": "github:Sn0wo2/web-rotate-core"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/html-to-text": "^9.0.4",
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2"
  }
}
