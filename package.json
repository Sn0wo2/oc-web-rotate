{
  "name": "oc-web-rotate",
  "version": "0.0.0",
  "description": "OpenCode 2 web search and fetch provider rotation",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/oc-web-rotate.git"
  },
  "packageManager": "bun@1.4.4",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5",
    "web-rotate-core": "0.1.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "zod": "^4.6.7",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@opencode/theme": "^2.2.5",
    "@opentui/core": "^0.8.2",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  }
}
