    "@opentui/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "zod": "^4.6.7",
    "glob": "14.0.4",
    "minimatch": "11.0.5",
    "qs": "^6.17.1",
    "tough-cookie": "^4.1.3",
    "postman-request": {
      ".": "2.88.1-postman.52",
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@opencode/theme": "^2.2.6",
    "@opentui/core": "^0.8.3",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/turndown": "^5.0.6",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  }
